import random # A library that contains random number functions and methods

#CODING CHALLENGE sol 1
def gen_random(min_val, max_val):
    # Calculate the total count of possible numbers (inclusive)
    r = max_val - min_val + 1
    
    # Pick a random number from 0 up to r-1, then shift it up by min_val
    x = random.randrange(r) + min_val
    
    return x

# Example usage:
result = gen_random(5, 10)
print(result)

